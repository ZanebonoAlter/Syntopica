# Multi-stage, self-contained build for the public read-only demo.
# Unlike the production Dockerfile (which expects a pre-built local Go binary),
# this image compiles both frontend and backend from source so anyone can build
# it on a clean checkout with only Docker installed.
#
# Build context must be the repo root (see demo/docker-compose.demo.yml).

# ----------------------------------------------------------------------------
# Stage 1: build the frontend static site with a same-origin API base.
# ----------------------------------------------------------------------------
FROM node:22-alpine AS front-build
WORKDIR /app
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# Corepack has its OWN registry config and does NOT read NPM_CONFIG_REGISTRY;
# without this it downloads the pinned pnpm binary from registry.npmjs.org,
# which is unreliable in CN. Must be set before any `pnpm` invocation.
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
# Enable pnpm (pinned via packageManager in front/package.json) BEFORE any
# pnpm invocation, else "pnpm: not found".
RUN corepack enable
# Pi 4（4GB）上 pnpm generate 实测默认堆 ~2GB 即 OOM（2026-09-22 与 Dockerfile 同步修复）
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN pnpm config set fetch-retries 5 && pnpm config set fetch-retry-mintimeout 20000 && pnpm config set fetch-retry-maxtimeout 120000
# Nuxt bakes runtimeConfig.public.apiBase at `generate` time, so inject the
# same-origin relative path here. resolveApiBase() returns "/api" verbatim for
# non-absolute values, and the browser then hits same-origin /api/* on :5000.
ENV NUXT_PUBLIC_API_BASE=/api
COPY front/package.json front/pnpm-lock.yaml ./
# patchedDependencies 配置在 pnpm-workspace.yaml（pnpm ≥10 从这里读）；
# 不拷则 three patch 被静默丢弃（--no-frozen-lockfile 会直接重写 lockfile 绕过校验）。
COPY front/pnpm-workspace.yaml ./
# patchedDependencies (three patch) references patches/* — must be present for
# install hash verification, else ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
COPY front/patches ./patches
# NOTE: --no-frozen-lockfile kept for compat with pre-existing lockfile state
# (pnpm-10 严格度下即使 workspace 配置齐全，历史 lockfile 也可能触发 frozen 拒绝)。
RUN pnpm install --no-frozen-lockfile
COPY front/ .
RUN pnpm generate

# ----------------------------------------------------------------------------
# Stage 2: compile the Go backend.
# ----------------------------------------------------------------------------
FROM golang:1.25-alpine AS back-build
WORKDIR /app
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
COPY backend-go/go.mod backend-go/go.sum ./
RUN for i in 1 2 3; do \
      go mod download && break; \
      if [ "$i" = "3" ]; then exit 1; fi; \
      sleep 5; \
    done
COPY backend-go/ .
RUN CGO_ENABLED=0 go build -trimpath -o /syntopica ./cmd/server

# ----------------------------------------------------------------------------
# Stage 3: minimal runtime image.
# ----------------------------------------------------------------------------
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata curl postgresql-client \
    && adduser -D -u 10001 appuser

WORKDIR /app

# Go binary + backend configs (config.yaml is still needed for non-DB defaults).
COPY --from=back-build /syntopica /app/syntopica
COPY backend-go/configs /app/configs

# Frontend static files served by the backend at / (static.go expects ./frontend).
COPY --from=front-build /app/.output/public/ /app/frontend/

# Sanitized seed data + startup script.
COPY demo/seed/seed.sql /app/seed.sql
COPY demo/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER appuser

ENV SERVER_PORT=5000 SERVER_MODE=release DEMO_READ_ONLY=1

EXPOSE 5000

ENTRYPOINT ["/app/entrypoint.sh"]
